{
  "name": "@dashfy/ext-system",
  "version": "0.1.0",
  "description": "Dashfy System extension - Monitor computer resources like CPU, memory, disk, network, etc",
  "keywords": [
    "dashfy",
    "dashboard",
    "widgets",
    "extension",
    "system",
    "monitor",
    "cpu",
    "memory",
    "disk",
    "network"
  ],
  "homepage": "https://github.com/dashfy/dashfy#readme",
  "bugs": {
    "url": "https://github.com/dashfy/dashfy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashfy/dashfy.git",
    "directory": "packages/ext-system"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Breno Polanski",
    "email": "breno.polanski@gmail.com",
    "url": "https://github.com/brenopolanski"
  },
  "type": "module",
  "dashfy": {
    "id": "system",
    "title": "System Monitor",
    "categories": [
      "monitoring"
    ],
    "widgets": [
      "CpuUsage",
      "CpuUsageGauge",
      "CpuUsageLine",
      "MemoryUsage",
      "MemoryUsageGauge",
      "MemoryUsageLine",
      "DiskUsage",
      "DiskUsageGauge",
      "NetworkStats",
      "NetworkStatsCompact",
      "NetworkStatsLine",
      "Processes",
      "SystemInfo"
    ],
    "client": {
      "import": "@dashfy/ext-system/client",
      "factory": "createSystemClient",
      "mode": "push"
    },
    "starter": [
      {
        "widget": "CpuUsageGauge"
      },
      {
        "widget": "MemoryUsageGauge"
      },
      {
        "widget": "DiskUsageGauge"
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dashfy/types": "workspace:*",
    "@dashfy/ui": "workspace:*",
    "@dashfy/utils": "workspace:*",
    "livegauge": "^0.0.2",
    "liveline": "^0.0.7",
    "systeminformation": "^5.31.3"
  },
  "peerDependencies": {
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dashfy/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.8.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.454.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.4"
  }
}
